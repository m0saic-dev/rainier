# dependencies
node_modules

# build output: dist/ and template-manifest.json are COMMITTED on purpose.
# Mosaic Desktop loads this repo from its GitHub URL and only ever imports
# dist/index.js, so a push without a fresh `npm run build` ships stale code.

# PRIVATE reference material: screenshots of real posts used to design a
# template. This repo is public, so real people's media, names, handles and
# lyrics never get committed. Keep refs here, locally.
ref/

# local render output
test-output

# OS files
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
